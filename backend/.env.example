# انسخ هذا الملف إلى .env واملأ القيم الحقيقية — لا ترفع .env على GitHub أبدًا
# Copy this file to .env and fill in real values. Never commit .env to GitHub.

PORT=3000

# رابط الاتصال بقاعدة بيانات PostgreSQL
DATABASE_URL=postgres://username:password@localhost:5432/winitex

# مفتاح سري طويل وعشوائي لتوقيع الجلسات (JWT) — غيّره قبل الإنتاج
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=8h

# تُستخدم مرة واحدة فقط بواسطة "npm run seed" لإنشاء أول حسابين
# Used only once by "npm run seed" to create the first two accounts.
SEED_ADMIN_EMAIL=admin@winitex-eg.com
SEED_ADMIN_PASSWORD=change-me-before-seeding
SEED_HR_EMAIL=hr@winitex-eg.com
SEED_HR_PASSWORD=change-me-before-seeding
